NODE_ENV=development
PORT=5000

# Frontend origins allowed to call the API, separated by commas.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional hosted PostgreSQL connection string. When present, it takes
# precedence over the individual DB_* connection fields below.
DATABASE_URL=

# Local PostgreSQL defaults.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=gallery_noir
DB_PASSWORD=replace_me
DB_NAME=gallery_noir
DB_CONNECTION_LIMIT=10
DB_CONNECTION_TIMEOUT_MS=10000
DB_IDLE_TIMEOUT_MS=30000
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_at_least_32_random_characters
JWT_EXPIRES_IN=7d
JWT_ISSUER=gallery-noir-api
JWT_AUDIENCE=gallery-noir-web
BCRYPT_ROUNDS=12
