# Local backend connected to hosted PostgreSQL. Run npm run setup first.
NODE_ENV=development
PORT=5000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Paste the complete External Database URL from Render here.
DATABASE_URL=
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true
DB_CONNECTION_LIMIT=5
DB_CONNECTION_TIMEOUT_MS=10000
DB_IDLE_TIMEOUT_MS=30000
# npm run setup generates this automatically on your computer.
JWT_SECRET=GENERATE_ON_SETUP
JWT_EXPIRES_IN=1h
JWT_ISSUER=gallery-noir-api
JWT_AUDIENCE=gallery-noir-web
BCRYPT_ROUNDS=12
# Required for email codes. Fill these before testing signup/sign-in.
RESEND_API_KEY=
EMAIL_FROM=
